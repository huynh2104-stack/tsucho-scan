# Môi trường & bí mật
.env
.venv/
venv/

# Cache kết quả API (chứa dữ liệu giao dịch cá nhân)
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Dữ liệu cá nhân (ảnh sổ ngân hàng, file kết quả) — không đưa lên git
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# Dữ liệu giao dịch thật (file chuẩn tay, output Claude Cowork, memory phiên Cowork)
mau-*.xlsx
Claude Cowork Outputs/
skills/
thùng-rác/

# Log chạy thật (chứa tên ngân hàng, tên file sổ của khách)
data/

# Web: ảnh sổ người dùng tải lên + Excel sinh ra (dữ liệu tài chính thật)
.data/

# Node / Next.js
node_modules/
web/.next/
web/out/
.next/
npm-debug.log*

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Next.js env cục bộ
web/.env.local
