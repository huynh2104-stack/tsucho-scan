# Sao chép file này thành .env rồi điền API key của bạn

# --- Anthropic (Claude) --- https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- Google Gemini (tùy chọn, CÓ BẬC MIỄN PHÍ ~1500 request/ngày) ---
# Lấy key miễn phí tại: https://aistudio.google.com/apikey (không cần thẻ)
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxx

# --- Model dùng để trích xuất. Bỏ trống = claude-sonnet-5 (mặc định) ---
# Chi phí/độ chính xác đo thực tế: xem bảng trong README.md
#   claude-sonnet-5         : chính xác nhất, ~$0.014-0.023/trang
#   gemini-2.5-flash        : ~$0.002/trang, MIỄN PHÍ với free tier — đã test, tốt
#   gemini-3.1-flash-lite   : ~$0.004/trang, mới hơn — chưa test
#   claude-haiku-4-5        : ~$0.007/trang nhưng chữ sai nhiều (đã test)
# Lưu ý: gemini-2.5-flash-lite đã ĐÓNG với người dùng mới (lỗi 404)
# EXTRACT_MODEL=gemini-2.5-flash
